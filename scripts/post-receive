#!/usr/bin/env bash
set -euo pipefail

GIT_DIR="/opt/learnify/.git"
WORK_TREE="/opt/learnify"
ENV_FILE="/opt/learnify/.env.production"
ENV_BAK="/root/.learnify/.env.production"

log()  { echo "[learnify-hook] $(date '+%Y-%m-%d %H:%M:%S') $1"; }
warn() { echo "[learnify-hook][WARN] $1" >&2; }

log "Post-receive hook fired"

log "Checking out latest code to ${WORK_TREE}"
GIT_WORK_TREE="$WORK_TREE" git checkout -f staging

if [[ -f "$ENV_FILE" ]]; then
    log ".env.production found at ${ENV_FILE}"
elif [[ -f "$ENV_BAK" ]]; then
    log "Restoring .env.production from ${ENV_BAK}"
    cp "$ENV_BAK" "$ENV_FILE"
else
    warn ".env.production not found — container may use empty defaults"
fi

log "Restarting Docker containers..."
cd "$WORK_TREE"
docker compose up -d --force-recreate

log "Pruning old Docker images..."
docker image prune -f

log "Deploy complete. Containers running:"
docker compose ps