# ─────────────────────────────────────────────────────────────────
# Learnify — Production Environment Variables
# Copy this file to .env.production on your VPS
# NEVER commit .env.production to the repo
# ─────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════
# BUILD-TIME VARS (VITE_*)
# These are baked into the client JS bundle at build time.
# They are NOT runtime env vars — they can't be changed without rebuild.
# These get passed to Docker via docker-compose build --build-arg
# ═════════════════════════════════════════════════════════════════

# Your GraphQL backend URL (public, used by the client)
VITE_GRAPHQL_ENDPOINT="https://your-backend.onrender.com/graphql"

# Google OAuth client ID (public, visible in browser JS)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ElevenLabs (TTS feature — optional)
# WARNING: This key is visible in browser source! Move to backend proxy for prod.
VITE_ELEVENLABS_API_KEY="sk_your_elevenlabs_key"
VITE_ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
VITE_ELENVENLABS_MODEL_ID="eleven_turbo_v2_5"
VITE_ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
VITE_ELENVENLABS_ENABLE_TIMESTAMPS="true"

# Edge TTS (fallback TTS — no API key needed)
VITE_EDGETTS_VOICE_ID="zh-CN-XiaoxiaoMultilingualNeural"

# ═════════════════════════════════════════════════════════════════
# RUNTIME VARS (server-side only)
# These are read by srvx at runtime from this file.
# They are NOT baked into the client bundle.
# ═════════════════════════════════════════════════════════════════

# Environment mode (must be "production" for SSR)
NODE_ENV="production"

# Session encryption secret — generate with: openssl rand -base64 48
# This encrypts the session cookie. If leaked, attackers can forge sessions.
SESSION_SECRET="replace-with-openssl-rand-base64-48"

# Backend URL (server-side only — used by srvx/server functions)
BACKEND_URL="https://your-backend.onrender.com/graphql"