#!/usr/bin/env sh

commit_msg_file=$1

# Skip lines starting with # and empty lines to find the actual commit header
commit_msg=$(grep -v '^#' "$commit_msg_file" | grep -v '^[[:space:]]*$' | head -n 1)

# Check if the commit message matches the required format with optional scope
if ! echo "$commit_msg" | grep -Eq "^(chore|feat|fix|docs|refactor|pef|style|UI)(\([^)]+\))?:[[:space:]]+.+"; then
  echo ""
  echo "❌ Error: Invalid commit message format."
  echo "The commit message must follow this convention:"
  echo "  <type>[optional scope]: <subject>"
  echo ""
  echo "Valid types are:"
  echo "  chore:    A code change that external user won't see (eg: change to .gitignore file or .prettierrc file)"
  echo "  feat:     A new feature"
  echo "  fix:      A bug fix"
  echo "  docs:     Documentation related changes"
  echo "  refactor: A code that neither fix bug nor adds a feature (eg: semantic changes like renaming a variable/function name)"
  echo "  pef:      A code that improves performance"
  echo "  style:    A code that is related to styling"
  echo "  UI:       A better styles"
  echo ""
  echo "Examples:"
  echo "  feat: add a new feature"
  echo "  fix(auth): solve login issue"
  echo "  UI: better button styles"
  echo ""
  exit 1
fi
